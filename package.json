{
  "name": "live-recorder",
  "version": "1.1.1",
  "description": "강의 곁의 로컬 녹음과 실시간 노트",
  "author": "cybereun",
  "repository": { "type": "git", "url": "https://github.com/cybereun/live-recorder.git" },
  "main": "desktop/main.cjs",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never --config.win.artifactName=Live-Recorder-Portable-${version}-${arch}.${ext}"
  },
  "dependencies": { "electron-updater": "^6.6.2" },
  "devDependencies": { "electron": "^41.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "com.cybereun.live-recorder",
    "npmRebuild": false,
    "productName": "Live Recorder",
    "publish": [{ "provider": "github", "owner": "cybereun", "repo": "live-recorder", "releaseType": "release" }],
    "directories": { "output": "dist" },
    "files": ["desktop/**", "index.html", "app.js", "styles.css", "server.js", "package.json"],
    "extraResources": [
      { "from": "bin", "to": "engine/bin" },
      { "from": "whisper-cpp/ggml-base.bin", "to": "engine/whisper-cpp/ggml-base.bin" },
      { "from": "build/engine/faster-whisper", "to": "engine/faster-whisper" },
      { "from": "build/models/small", "to": "engine/models/small" },
      { "from": "assets/live-recorder.ico", "to": "live-recorder.ico" }
    ],
    "win": { "icon": "assets/live-recorder.ico", "target": "nsis", "artifactName": "Live-Recorder-Setup-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "runAfterFinish": true }
  }
}
